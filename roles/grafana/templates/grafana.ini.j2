# {{ ansible_managed }}
# Grafana configuration template
# Referenced by cloudalchemy.grafana; the role generates grafana.ini
# from its own template using the grafana_* variables.
# This file acts as a reference for customisation points.
#
[server]
# addr is managed by grafana_address
# port is managed by grafana_port
# domain is managed by grafana_domain
# root_url is managed by grafana_url
protocol = http
enable_gzip = false

[security]
admin_user = admin

[users]
allow_sign_up = false
auto_assign_org_role = Viewer
default_theme = dark

[auth.anonymous]
enabled = false

[alerting]
execute_alerts = true

[log]
mode = console file
level = info